    {
      "id": "readme_coven_mcp_allowed_roots",
      "label": "COVEN_MCP_ALLOWED_ROOTS",
      "file_type": "concept",
      "source_file": "README.md",
      "source_location": "Configuration",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Colon-separated absolute roots gating all write tools; unset means read-only; any invalid entry aborts startup naming its position (never its value) so a misconfigured allowlist is never partially honored; containment is path-component based after symlink resolution so /work/app2 is never inside /work/app."
    },
    {
      "id": "readme_resume_token",
      "label": "Resume Token",
      "file_type": "concept",
      "source_file": "README.md",
      "source_location": "Security and privacy",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "HMAC-signed with a random per-process secret, session-bound and size-capped; integrity-protected but not encrypted since the payload includes un-emitted output state, so tokens must be treated as session output and never logged."
    },
    {
      "id": "readme_ansi_cr_sanitizer",
      "label": "ANSI/CR Sanitizer",
      "file_type": "concept",
      "source_file": "README.md",
      "source_location": "Architecture",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Raw PTY output (ANSI escapes, carriage-return progress bars, lines split across events) is reassembled into plain text because the consumer is an LLM, not a terminal emulator."
    },
    {
      "id": "readme_capability_handshake",
      "label": "Capability Handshake",
      "file_type": "concept",
      "source_file": "README.md",
      "source_location": "How OpenCoven was used",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Every non-health call requires ok===true, apiVersion coven.daemon.v1, and the needed capability advertised as exactly true; string capabilities are diagnostic only, and the legacy /api/v1/api-version route is deliberately unused because upstream documents it as not proof of support."
    },
    {
      "id": "readme_error_codes",
      "label": "Error Codes",
      "file_type": "concept",
      "source_file": "README.md",
      "source_location": "Error codes",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "readme_trust_model",
      "label": "Trust Model",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": "Security and privacy",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Daemon trust is same-user socket access with no authentication, so coven-mcp inherits full same-user authority and its job is to narrow it before an LLM touches it; the allowlist is authorization not a sandbox; tool results are untrusted content with respect to prompt injection (encoding sanitized, meaning not); anyone with same-user access can bypass coven-mcp entirely."
    },
    {
      "id": "readme_verify_pipeline",
      "label": "Verify Pipeline",
      "file_type": "concept",
      "source_file": "README.md",
      "source_location": "Test or verify",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "npm run verify needs no credentials, daemon, or network so a judge can prove the package from a clean clone in seconds; contract tests bind a real HTTP server to a temporary Unix socket rather than mocking node:http internals."
    },
    {
      "id": "readme_demo",
      "label": "Demo",
      "file_type": "concept",
      "source_file": "README.md",
      "source_location": "Demo",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "npm run demo drives the real built server over real MCP stdio against a scripted stand-in daemon: deterministic, no credentials or provider spend, so the demo artifact works for judges without a Coven install."
    }
  ],
