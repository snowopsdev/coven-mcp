    {
      "id": "readme_coven_send_input",
      "label": "coven_send_input",
      "file_type": "concept",
      "source_file": "README.md",
      "source_location": "Tool reference",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Forwards data to the PTY verbatim with no appended newline, so callers must include a trailing newline to submit a line — rewriting input would make the bridge lossy."
    },
    {
