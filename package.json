{
  "name": "coven-mcp",
  "version": "0.1.0",
  "description": "MCP server bridging the Coven daemon to any stdio-capable MCP client",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "coven-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/architecture.html",
    "docs/architecture.json",
    "docs/architecture-preview.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "demo": "npm run build && node scripts/demo.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && node scripts/stdio-smoke.mjs && node scripts/check-package.mjs && node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
